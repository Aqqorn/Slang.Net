<Project>
  <!-- This targets file is specifically for buildTransitive to handle transitive dependencies -->
  <PropertyGroup>
    <SlangSdkBuildTransitiveImported>true</SlangSdkBuildTransitiveImported>
  </PropertyGroup>

  <!-- Import the main targets file only if we're being used transitively -->
  <Import Project="$(MSBuildThisFileDirectory)../build/Slang.Sdk.targets" Condition="'$(SlangSdkNativeTargetsImported)' != 'true'" />
</Project>